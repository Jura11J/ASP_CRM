@model Product
@{
    ViewData["Title"] = "Szczegóły produktu";
}

@{
    var pl = CultureInfo.GetCultureInfo("pl-PL");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">@Model.Name</h2>
        <p class="text-muted mb-0">SKU: @Model.Sku</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Powrót</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edytuj</a>
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-url="@Url.Action("Delete", new { id = Model.Id })">Usuń</button>
    </div>
</div>

<div class="card p-4">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="form-section-title mb-1">Cena</div>
            <div class="fs-4 fw-bold">@Model.Price.ToString("C", pl)</div>
        </div>
        <div class="col-md-4">
            <div class="form-section-title mb-1">Stan magazynu</div>
            <div class="fs-4 fw-bold">@Model.StockQuantity</div>
        </div>
        <div class="col-md-4">
            <div class="form-section-title mb-1">Status</div>
            @if (Model.IsActive)
            {
                <span class="badge bg-success">Aktywny</span>
            }
            else
            {
                <span class="badge bg-secondary">Nieaktywny</span>
            }
        </div>
    </div>

    <div class="mt-4">
        <div class="form-section-title mb-1">Opis</div>
        <p class="mb-0">@Model.Description</p>
    </div>
</div>
