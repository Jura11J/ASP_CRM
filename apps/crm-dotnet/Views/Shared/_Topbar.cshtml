@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<header class="topbar bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-outline-secondary d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu">
            <i class="bi bi-list"></i>
        </button>
        <div>
            <div class="fw-semibold">CRM sklepu internetowego</div>
            <div class="text-muted small">Obsługa klientów, zamówień i wsparcia</div>
        </div>
    </div>
    <div class="d-flex align-items-center gap-3">
        <span class="badge bg-primary-subtle text-primary">Tryb demo</span>
        @if (SignInManager.IsSignedIn(User))
        {
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center gap-2 mb-0">
                @Html.AntiForgeryToken()
                <span class="text-muted small">@User.Identity?.Name</span>
                <button type="submit" class="btn btn-sm btn-outline-secondary">Wyloguj</button>
            </form>
        }
        else
        {
            <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">Zaloguj</a>
        }
    </div>
</header>
