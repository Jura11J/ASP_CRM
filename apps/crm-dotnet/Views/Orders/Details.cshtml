@model Order
@{
    var pl = System.Globalization.CultureInfo.GetCultureInfo("pl-PL");
    ViewData["Title"] = $"Zamówienie #{Model.Id}";
    string StatusClass(OrderStatus status) => status switch
    {
        OrderStatus.New => "badge bg-secondary",
        OrderStatus.Paid => "badge bg-info text-dark",
        OrderStatus.Shipped => "badge bg-warning text-dark",
        OrderStatus.Completed => "badge bg-success",
        _ => "badge bg-danger"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Zamówienie #@Model.Id</h2>
        <p class="text-muted mb-0">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Powrót</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edytuj</a>
        <button class="btn btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-url="@Url.Action("Delete", new { id = Model.Id })">Usuń</button>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Klient</h5>
                <span class="@StatusClass(Model.Status)">@Model.Status.GetDisplayName()</span>
            </div>
            <div class="mt-2">
                <div class="fw-semibold">@Model.Customer?.FullName</div>
                <div class="text-muted small">@Model.Customer?.Email</div>
                <div class="text-muted small">@Model.Customer?.Phone</div>
                <div class="text-muted small">@Model.Customer?.AddressLine1, @Model.Customer?.City</div>
            </div>
            <div class="mt-3">
                <div class="form-section-title">Wartość zamówienia</div>
                <div class="fs-4 fw-bold">@Model.TotalAmount.ToString("C", pl)</div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card p-3 h-100">
            <h5>Pozycje</h5>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Produkt</th>
                            <th>Ilość</th>
                            <th>Cena</th>
                            <th class="text-end">Razem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Product?.Name</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("C", pl)</td>
                                <td class="text-end">@item.LineTotal.ToString("C", pl)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card p-3 h-100">
            <h5>Historia statusów</h5>
            <ul class="list-group list-group-flush">
                @foreach (var history in Model.StatusHistory.OrderByDescending(h => h.ChangedAt))
                {
                    <li class="list-group-item">
                        <div class="fw-semibold">@history.Status.GetDisplayName()</div>
                        <div class="text-muted small">@history.ChangedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        <div class="small">@history.Note</div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
