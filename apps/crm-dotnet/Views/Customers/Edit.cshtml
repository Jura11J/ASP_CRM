@model Customer
@{
    ViewData["Title"] = "Edytuj klienta";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Edytuj klienta</h2>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Podgląd</a>
</div>

<div class="card p-4">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="AddressLine1" class="form-label"></label>
                <input asp-for="AddressLine1" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="PreferredContactMethod" class="form-label"></label>
                <input asp-for="PreferredContactMethod" class="form-control" />
            </div>
            <div class="col-md-3">
                <div class="form-check mt-4">
                    <input asp-for="MarketingConsent" class="form-check-input" />
                    <label asp-for="MarketingConsent" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-check mt-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex justify-content-end gap-2">
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Anuluj</a>
            <button type="submit" class="btn btn-primary">Zapisz</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
