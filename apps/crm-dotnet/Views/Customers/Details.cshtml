@model CustomerDetailViewModel
@{
    var pl = System.Globalization.CultureInfo.GetCultureInfo("pl-PL");
    ViewData["Title"] = "Szczegóły klienta";
    string StatusBadge(bool isActive) => isActive ? "badge bg-success" : "badge bg-secondary";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">@Model.Customer.FullName</h2>
        <p class="text-muted mb-0">Klient od @Model.Customer.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Powrót</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Customer.Id">Edytuj</a>
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-url="@Url.Action("Delete", new { id = Model.Customer.Id })">Usuń</button>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">Dane kontaktowe</h5>
                <span class="@StatusBadge(Model.Customer.IsActive)">@((Model.Customer.IsActive ? "Aktywny" : "Zablokowany"))</span>
            </div>
            <dl class="row mb-0">
                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Customer.Email</dd>
                <dt class="col-sm-4">Telefon</dt>
                <dd class="col-sm-8">@Model.Customer.Phone</dd>
                <dt class="col-sm-4">Adres</dt>
                <dd class="col-sm-8">@Model.Customer.AddressLine1, @Model.Customer.City</dd>
                <dt class="col-sm-4">Kontakt</dt>
                <dd class="col-sm-8">@Model.Customer.PreferredContactMethod</dd>
                <dt class="col-sm-4">Marketing</dt>
                <dd class="col-sm-8">@((Model.Customer.MarketingConsent ? "TAK" : "NIE"))</dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card p-3 h-100">
            <h5>Notatki</h5>
            <div class="note-block mb-3">
                <form asp-action="AddNote" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="NewNote.CustomerId" />
                    <div class="mb-2">
                        <label asp-for="NewNote.Content" class="form-label">Nowa notatka</label>
                        <textarea asp-for="NewNote.Content" class="form-control" rows="3" placeholder="Dodaj krótką notatkę..."></textarea>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <input asp-for="NewNote.Author" class="form-control" placeholder="Autor" />
                        </div>
                        <div class="col-md-6 text-end">
                            <button class="btn btn-primary" type="submit">Zapisz notatkę</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="list-group small">
                @foreach (var note in Model.Notes)
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <span class="fw-semibold">@note.Author</span>
                            <span class="text-muted">@note.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <div>@note.Content</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-7">
        <div class="card p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">Historia zamówień</h5>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Orders" asp-action="Create" asp-route-customerId="@Model.Customer.Id">Nowe zamówienie</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Data</th>
                            <th>Status</th>
                            <th class="text-end">Suma</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td><span class="badge bg-secondary">@order.Status.GetDisplayName()</span></td>
                                <td class="text-end">@order.TotalAmount.ToString("C", pl)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">Zgłoszenia</h5>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Tickets" asp-action="Create" asp-route-customerId="@Model.Customer.Id">Nowe zgłoszenie</a>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var ticket in Model.Tickets)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold">@ticket.Title</div>
                            <div class="text-muted small">@ticket.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</div>
                        </div>
                        <span class="badge bg-info text-dark">@ticket.Status</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
