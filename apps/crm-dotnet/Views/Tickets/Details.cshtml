@model Ticket
@{
    ViewData["Title"] = "Szczegóły zgłoszenia";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">@Model.Title</h2>
        <p class="text-muted mb-0">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Powrót</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edytuj</a>
        <button class="btn btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-url="@Url.Action("Delete", new { id = Model.Id })">Usuń</button>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card p-3 h-100">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="form-section-title">Klient</div>
                    <div class="fw-semibold">@Model.Customer?.FullName</div>
                    <div class="text-muted small">@Model.Customer?.Email</div>
                    <div class="text-muted small">@Model.Customer?.Phone</div>
                </div>
                <div class="text-end">
                    <span class="badge bg-warning text-dark">@Model.Priority.GetDisplayName()</span>
                    <div class="mt-1"><span class="badge bg-info text-dark">@Model.Status.GetDisplayName()</span></div>
                </div>
            </div>
            <div class="mt-3">
                <div class="form-section-title">Opis</div>
                <p class="mb-0">@Model.Description</p>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card p-3 h-100 d-flex flex-column">
            <h5>Komentarze</h5>
            <div class="flex-grow-1">
                <div class="list-group mb-3">
                    @foreach (var comment in Model.Comments)
                    {
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <span class="fw-semibold">@comment.Author</span>
                                <span class="text-muted small">@comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            <div>@comment.Content</div>
                        </div>
                    }
                </div>
            </div>

            <form asp-action="AddComment" method="post" class="mt-auto">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="row g-2">
                    <div class="col-md-8">
                        <label class="form-label">Komentarz</label>
                        <textarea name="content" class="form-control" rows="2" required></textarea>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Autor</label>
                        <input type="text" name="author" class="form-control" placeholder="Twoje imię" />
                    </div>
                </div>
                <div class="mt-2 text-end">
                    <button class="btn btn-primary" type="submit">Dodaj komentarz</button>
                </div>
            </form>
        </div>
    </div>
</div>
