@model AspCrm.ViewModels.ChatConversationPageVm
@using AspCrm.Models

@{
    ViewData["Title"] = "Czat live";
    var selected = Model.SelectedConversation;
    var lastMessageId = Model.Messages.LastOrDefault()?.Id ?? 0;
    var isClosed = selected?.IsClosed ?? false;
}

<div class="d-flex flex-column gap-3" id="liveChatRoot"
     data-selected-id="@(selected?.Id.ToString() ?? string.Empty)"
     data-last-id="@lastMessageId"
     data-is-closed="@isClosed.ToString().ToLowerInvariant()">

    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1">Czat live</h1>
            <p class="text-muted mb-0">Rozmowy między klientami sklepu a zespołem CRM.</p>
        </div>
        <div>
            <span class="badge text-bg-light border">Konwersacje: @Model.Conversations.Count</span>
        </div>
    </div>

    <form id="liveChatTokenForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div class="row g-3">
        <div class="col-12 col-lg-4 col-xxl-3">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <strong>Rozmowy</strong>
                </div>
                <div class="list-group list-group-flush" id="conversationList">
                    @if (Model.Conversations.Count == 0)
                    {
                        <div class="p-3 text-muted small">Brak aktywnych rozmów.</div>
                    }
                    else
                    {
                        foreach (var convo in Model.Conversations)
                        {
                            var isActive = Model.SelectedConversationId == convo.ConversationId;
                            <a class="list-group-item list-group-item-action d-flex flex-column gap-1 @(isActive ? "active" : string.Empty)"
                               asp-controller="LiveChat"
                               asp-action="Index"
                               asp-route-conversationId="@convo.ConversationId"
                               data-conversation-id="@convo.ConversationId"
                               data-last-message-at="@convo.LastMessageAt.ToString("O")">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold">@convo.CustomerName</span>
                                    <small class="@(isActive ? "text-white-50" : "text-muted")" data-role="time">
                                        @convo.LastMessageAt.ToLocalTime().ToString("g")
                                    </small>
                                </div>
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <small class="text-truncate @(isActive ? "text-white-50" : "text-muted")" data-role="preview">
                                        @(string.IsNullOrWhiteSpace(convo.LastMessagePreview) ? "(brak wiadomości)" : convo.LastMessagePreview)
                                    </small>
                                    <div class="d-flex align-items-center gap-1">
                                        @if (convo.IsClosed)
                                        {
                                            <span class="badge rounded-pill text-bg-secondary" title="Zamknięta"><i class="bi bi-lock"></i></span>
                                        }
                                        @if (convo.UnreadCount > 0)
                                        {
                                            <span class="badge rounded-pill text-bg-warning text-dark" data-role="unread">@convo.UnreadCount</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill text-bg-light border d-none" data-role="unread">0</span>
                                        }
                                    </div>
                                </div>
                                <small class="@(isActive ? "text-white-50" : "text-muted")">@convo.CustomerEmail</small>
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8 col-xxl-9">
            <div class="card shadow-sm h-100 d-flex flex-column">
                @if (selected?.Customer == null)
                {
                    <div class="card-body text-muted">Wybierz rozmowę z listy.</div>
                }
                else
                {
                    <div class="card-header bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                        <div>
                            <div class="fw-semibold">@selected.Customer.FullName</div>
                            <div class="text-muted small">@selected.Customer.Email • @selected.Customer.Phone</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Customers" asp-action="Details" asp-route-id="@selected.CustomerId">
                                Karta klienta
                            </a>
                            <button type="button" class="btn btn-outline-dark btn-sm" id="toggleConversationBtn" data-conversation-id="@selected.Id">
                                @(selected.IsClosed ? "Otwórz" : "Zamknij") rozmowę
                            </button>
                        </div>
                    </div>

                    <div class="card-body d-flex flex-column gap-3" style="min-height: 60vh;">
                        <div class="alert alert-secondary py-2 px-3 mb-0 @(selected.IsClosed ? string.Empty : "d-none")" id="conversationClosedAlert">
                            Ta rozmowa jest zamknięta. Możesz ją ponownie otworzyć.
                        </div>

                        <div id="chatMessages" class="flex-grow-1 border rounded-3 p-3 bg-light-subtle overflow-auto d-flex flex-column gap-2"
                             data-conversation-id="@selected.Id"
                             data-current-user-id="@Model.CurrentUserId">
                            @if (Model.Messages.Count == 0)
                            {
                                <div class="text-muted small">Brak wiadomości. Napisz pierwszą odpowiedź.</div>
                            }
                            else
                            {
                                foreach (var message in Model.Messages)
                                {
                                    var isOwn = message.IsOwn;
                                    var bubbleClass = isOwn ? "bg-primary text-white" : "bg-white border";
                                    var alignClass = isOwn ? "align-self-end" : "align-self-start";
                                    <div class="chat-bubble @alignClass @bubbleClass rounded-3 px-3 py-2 shadow-sm" data-message-id="@message.Id">
                                        <div class="small fw-semibold @(isOwn ? "text-white-50" : "text-muted")">@message.SenderLabel</div>
                                        <div class="white-space-prewrap">@message.Content</div>
                                        <div class="text-end small @(isOwn ? "text-white-50" : "text-muted")">@message.SentAt.ToLocalTime().ToString("g")</div>
                                    </div>
                                }
                            }
                        </div>

                        <form id="chatSendForm" class="d-flex flex-column flex-md-row gap-2">
                            <div class="flex-grow-1">
                                <label for="chatMessageInput" class="form-label mb-1">Twoja wiadomość</label>
                                <textarea id="chatMessageInput" class="form-control" rows="3" maxlength="2000" placeholder="Napisz wiadomość do klienta..." @(selected.IsClosed ? "disabled" : string.Empty)></textarea>
                            </div>
                            <div class="d-flex flex-md-column justify-content-end gap-2">
                                <button type="submit" class="btn btn-primary" id="chatSendBtn" @(selected.IsClosed ? "disabled" : string.Empty)>
                                    Wyślij
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="chatRefreshBtn">
                                    Odśwież
                                </button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/liveChat.js" asp-append-version="true"></script>
}
